{
    "compilerOptions": {
        "experimentalDecorators": true,
        "emitDecoratorMetadata": true,
        "module": "commonjs",
        "target": "ES6",
        "outDir": "build",
        "rootDir": "api",
        "sourceMap": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "skipLibCheck": true
       // "watch": true
    },
    "exclude": [
        "./client/**/*",
        "node_modules",
        "node_modules/**"
    ]
}